VITE_SITE_URL=https://your-cloudflare-subdomain.workers.dev
VITE_REACT_APP_GEOAPIFY_API_KEY=
VITE_API_URL=
# Optional. Defaults to the API origin + /socket (http -> ws, https -> wss).
VITE_WS_URL=
VITE_MAINTENANCE_MODE=false
# Optional CDN / Cloudflare R2 asset host used to resolve raw user image
# filenames from the `images` array. VITE_CDN_URL is used as a fallback.
VITE_ASSET_HOST=
VITE_CDN_URL=
